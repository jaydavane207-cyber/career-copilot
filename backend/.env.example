PORT=5000
NODE_ENV=development

# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_copilot

# Database dialect ('postgres' or 'sqlite')
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=career_copilot
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Optional fallback: Set to true to use SQLite if Postgres is not immediately available
USE_SQLITE_FALLBACK=true

# Authentication
JWT_SECRET=career_copilot_super_secure_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=7d

# CORS Client URL
CLIENT_URL=http://localhost:5173
