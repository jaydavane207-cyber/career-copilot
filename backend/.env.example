PORT=5000
NODE_ENV=development

# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_copilot

# Database dialect ('postgres' or 'sqlite')
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=career_copilot
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Optional fallback: Set to true to use SQLite if Postgres is not immediately available
USE_SQLITE_FALLBACK=true

# Authentication
JWT_SECRET=career_copilot_super_secure_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=7d

# CORS Client URL
CLIENT_URL=http://localhost:5173

# Google Gemini API Key (Free Tier from https://aistudio.google.com/)
GEMINI_API_KEY=your_free_api_key_here

# LinkedIn OAuth Configuration
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/linkedin/callback

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Token Encryption (AES-256)
ENCRYPTION_KEY=generate_a_strong_key_here
