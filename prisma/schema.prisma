datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum InterviewType {
  OA
  TECHNICAL
  HR
  MANAGERIAL
  SCREENING
  OTHER
}

enum InterviewMode {
  ONLINE
  OFFLINE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewOutcome {
  PASS
  FAIL
  PENDING
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  timezone      String          @default("Asia/Kolkata")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  applications  Application[]
  interviews    InterviewEvent[]
  calendarToken CalendarToken?
  learningPaths LearningPath[]
  learningTasks LearningTask[]
}

model Application {
  id          String           @id @default(cuid())
  userId      String
  company     String
  role        String
  status      String           @default("APPLIED")
  appliedDate DateTime?        @default(now())
  salary      String?
  location    String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews  InterviewEvent[]

  @@index([userId])
}

model InterviewEvent {
  id              String            @id @default(cuid())
  userId          String
  applicationId   String

  title           String
  type            InterviewType     @default(TECHNICAL)
  mode            InterviewMode     @default(ONLINE)

  scheduledStart  DateTime
  durationMin     Int               @default(45)
  timezone        String            @default("Asia/Kolkata")

  meetingLink     String?
  location        String?
  interviewerName String?

  status          InterviewStatus   @default(SCHEDULED)
  outcome         InterviewOutcome?
  notes           String?
  feedback        String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  application     Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledStart])
  @@index([applicationId])
}

model CalendarToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum LearningPathFocusMode {
  BALANCED
  OA_FIRST
  INTERVIEW_FIRST
}

enum LearningTaskType {
  LEARN
  PRACTICE
  REVISE
  MOCK
}

enum LearningTaskStatus {
  PENDING
  DONE
  SKIPPED
}

model LearningPath {
  id                     String                @id @default(cuid())
  userId                 String
  title                  String
  targetRoleKey          String?
  durationWeeks          Int
  hoursPerWeek           Int
  focusMode              LearningPathFocusMode @default(BALANCED)
  sourceResumeAnalysisId String?
  startDate              DateTime              @default(now())
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeks                  LearningWeek[]
  tasks                  LearningTask[]

  @@index([userId, createdAt])
}

model LearningWeek {
  id          String         @id @default(cuid())
  pathId      String
  weekNumber  Int
  title       String
  skillIds    Json
  goalSummary String?
  createdAt   DateTime       @default(now())

  path        LearningPath   @relation(fields: [pathId], references: [id], onDelete: Cascade)
  tasks       LearningTask[]

  @@unique([pathId, weekNumber])
  @@index([pathId])
}

model LearningTask {
  id            String             @id @default(cuid())
  weekId        String
  pathId        String
  userId        String
  type          LearningTaskType
  title         String
  description   String?
  durationMin   Int
  resourceUrl   String?
  resourceTitle String?
  skillIds      Json
  status        LearningTaskStatus @default(PENDING)
  completedAt   DateTime?
  createdAt     DateTime           @default(now())

  week          LearningWeek       @relation(fields: [weekId], references: [id], onDelete: Cascade)
  path          LearningPath       @relation(fields: [pathId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([pathId])
}

